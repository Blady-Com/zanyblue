   ----------------

   procedure Initialize (Catalog : ZTC.Catalog_Type := Standard_Catalog) is
   begin
      ZTC.Initialize
        (Catalog, Messages, Pool, Facilities, Keys, Locales,
         "ZBMCompile.Messages", Pool_Data_1.Length, 10_745);
   end Initialize;

   ----------
   --- Key --
   ----------

   function Key
     (Index : Positive)
      return String
   is
   begin
      return Keys (Index).all;
   end Key;

   ----------------
   --- Key_Count --
   ----------------

   function Key_Count return Natural is
   begin
      return Keys'Length;
   end Key_Count;

